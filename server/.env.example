# One shared backend serves the production frontend and API.
PORT=5001
NODE_ENV=development
APP_URL=http://localhost:5001
# Required in production: generate once using crypto.randomBytes(48).toString('hex').
JWT_SECRET=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ctump_docugov
DB_CONNECTION_LIMIT=10
GOOGLE_CLIENT_ID=
# Applied only to verified Google accounts that do not already exist in the DB.
ADMIN_EMAILS=tranthibaotran.2k@gmail.com,toanhkhai@gmail.com,toanhkhai12345@gmail.com,admin@ctump.edu.vn,heykagvip@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFICATION_EMAIL=tranthibaotran.2k@gmail.com
# Missing SMTP credentials queue mail as PENDING; they never simulate SENT.
MAIL_DISABLED=false
# Optional: absolute persistent storage path. Default is server/uploads.
# UPLOAD_DIR=/data/uploads
# FONT_DIR=/usr/share/fonts/truetype/liberation2
# ALLOWED_ORIGINS=https://your-domain.example
# Default trusts only a local reverse proxy (cloudflared/nginx on this host).
# Use false for direct access, or explicit proxy IP/CIDR addresses on other hosts.
TRUST_PROXY=loopback
