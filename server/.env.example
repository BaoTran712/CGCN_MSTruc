# Cấu hình Server NodeJS
PORT=5000
NODE_ENV=development

# Cấu hình Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ctump_cgcn

# Cấu hình Gmail SMTP (Gửi email tự động thông báo qua các bước)
# Lưu ý: Dùng Mật khẩu ứng dụng (App Password) từ tài khoản Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=khcn@ctump.edu.vn
SMTP_PASS=your_app_password_here
EMAIL_FROM="CTUMP DocuGov <khcn@ctump.edu.vn>"

# Thư mục Google Drive lưu trữ hồ sơ chính thức (Quy định trong quy_trinh.md)
