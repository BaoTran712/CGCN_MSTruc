{
  "name": "ctump-docugov",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:all": "node scripts/dev.js",
    "start": "node scripts/dev.js",
    "server": "node server/src/server.js",
    "server:dev": "node --watch --watch-path=server/src server/src/server.js",
    "db:import": "node server/scripts/importDb.js",
    "db:backup": "node server/scripts/backupDb.js",
    "check:db": "node server/scripts/check_db.js",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "docx": "^9.8.1",
    "docxtemplater": "^3.71.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "pizzip": "^3.3.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "mysql2": "^3.10.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
