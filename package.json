{
  "name": "ctump-docugov",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:all": "node scripts/dev.js",
    "start": "node scripts/start.js",
    "server": "node server/src/server.js",
    "server:dev": "node --watch --watch-path=server/src server/src/server.js",
    "db:import": "node server/scripts/importDb.js",
    "db:backup": "node server/scripts/backupDb.js",
    "check:db": "node server/scripts/check_db.js",
    "check:smtp": "node server/scripts/check_smtp.js",
    "test:mail": "node --test server/tests/mail.test.js",
    "test:login": "node --test server/tests/login.test.js",
    "test:outbox": "node server/tests/outbox.js",
    "test:runtime": "node --test server/tests/runtime.test.js",
    "test:sql": "node server/tests/source-sql.js",
    "test:signed-ui": "node server/tests/signed-ui.js",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "db:migrate": "node server/scripts/migrateDb.js",
    "db:sql": "node server/scripts/generateInitSql.js",
    "user:password": "node server/scripts/setPassword.js",
    "test": "node --experimental-vm-modules --test server/tests/unit.test.js",
    "test:integration": "node server/tests/integration.js",
    "setup": "npm ci && npm --prefix server ci && node scripts/setupEnv.js",
    "test:migration": "node server/tests/migration-check.js",
    "user:bootstrap": "node server/scripts/bootstrapAdmin.js",
    "share:https": "node scripts/shareHttps.js"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "docx": "^9.8.1",
    "docxtemplater": "^3.71.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "pizzip": "^3.3.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "mysql2": "^3.10.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
